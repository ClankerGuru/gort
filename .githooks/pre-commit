#!/usr/bin/env bash
set -euo pipefail

echo "=== Pre-commit: running build ==="
# Skip iOS/native compilation locally — too heavy for constrained environments.
# Full multi-platform build runs in CI.
./gradlew \
    :gort:compileKotlinDesktop \
    :gort:compileKotlinWasmJs \
    :gort:desktopTest \
    :catalog:compileKotlinDesktop \
    :catalog:compileKotlinWasmJs \
    --no-daemon || {
    echo ""
    echo "❌ Build failed. Fix the errors before committing."
    exit 1
}
echo "✅ Build passed."
